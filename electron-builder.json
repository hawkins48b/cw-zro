{
	"appId": "ch.chocolatewarfare.app.zro",
	"productName": "ZRO",
	"directories": {
		"output": "dist-electron"
	},
	"files": ["build/**/*", "electron/**/*", "package.json"],
	"win": {
		"target": "nsis",
		"icon": "build/favicon.png"
	},
	"nsis": {
		"oneClick": false,
		"allowToChangeInstallationDirectory": true
	},
	"mac": {
		"target": "dmg",
		"icon": "build/favicon.png"
	},
	"linux": {
		"target": "AppImage",
		"icon": "build/favicon.png"
	}
}
