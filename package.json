{
	"name": "cw-zro",
	"description": "ZRO — Ballistic calculator for precision shooting sports and long-range marksmanship",
	"license": "MIT",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"main": "electron/main.js",
	"desktopName": "cw-zro.desktop",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:mobile": "BUILD_TARGET=capacitor vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest",
		"test:run": "vitest run",
		"audit:check": "node scripts/audit-check.js",
		"cap:sync": "npm run build:mobile && npx cap sync",
		"cap:android": "npm run cap:sync && npx cap open android",
		"cap:ios": "npm run cap:sync && npx cap open ios",
		"electron:dev": "npm run build && electron .",
		"electron:build": "npm run build && electron-builder --config electron-builder.json"
	},
	"devDependencies": {
		"@inlang/plugin-message-format": "4.6.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"electron": "^45.2.3",
		"electron-builder": "^26.18.1",
		"jsdom": "^31.0.0",
		"svelte": "^5.57.3",
		"tailwindcss": "^4.3.4",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@capacitor/android": "^8.6.0",
		"@capacitor/app": "^8.1.2",
		"@capacitor/cli": "^8.6.0",
		"@capacitor/core": "^8.6.0",
		"@capacitor/ios": "^8.6.0",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.4",
		"@inlang/paraglide-js": "^3.1.0",
		"@lucide/svelte": "^1.69.0",
		"apexcharts": "^5.16.0",
		"electron-serve": "^3.0.1",
		"js-ballistics": "2.2.0-beta.2",
		"pdf-lib": "^1.17.1",
		"svelte-gestures": "^5.2.2"
	}
}
